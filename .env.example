# Local demonstration settings. For anything beyond a local demo run `python scripts/bootstrap.py`,
# which writes .env with random secrets, then set CAMPUS_DEMO=0.
CAMPUS_DEMO=1
CAMPUS_DEMO_PASSWORD=CampusDemo!2026
CAMPUS_ORIGINS=http://localhost:8080,https://localhost:8443,http://127.0.0.1:8080,http://localhost:5173

POSTGRES_PASSWORD=change-me-postgres-superuser
IDENTITY_OWNER_PASSWORD=change-me-identity-owner
IDENTITY_APP_PASSWORD=change-me-identity-app
ACADEMIC_OWNER_PASSWORD=change-me-academic-owner
ACADEMIC_APP_PASSWORD=change-me-academic-app
FINANCE_OWNER_PASSWORD=change-me-finance-owner
FINANCE_APP_PASSWORD=change-me-finance-app
HR_OWNER_PASSWORD=change-me-hr-owner
HR_APP_PASSWORD=change-me-hr-app
REPLICATION_PASSWORD=change-me-replication

RABBITMQ_USER=campus
RABBITMQ_PASSWORD=change-me-rabbitmq

# Provider callback signature, QR attendance signature and simulator API key (demo mode only accepts these defaults).
WEBHOOK_SECRET=local-development-only-secret
QR_SECRET=local-development-only-secret
SIMULATOR_KEY=local-development-only-secret

GRAFANA_PASSWORD=change-me-grafana
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7
